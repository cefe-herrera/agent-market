DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/bnb_agent_marketplace?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:4200,http://localhost:3000,http://localhost:3001"

# Java ERC-8004 indexer + x402 facilitator (Nest marketplace v1)
# Local defaults; VPS example: http://149.50.155.168:8085 / :8080
INDEXER_BNB_URL=http://127.0.0.1:8085
FACILITATOR_URL=http://127.0.0.1:8080
X402_PAY_TO=0xA457Dd1a8D9E243f229EB919d7a08b43802aeD8b

# 8004scan + x402 payment chain — mainnet | testnet
# Override with npm run dev:mainnet / npm run dev:testnet
# Facilitator: cd x402-rs && NETWORK=mainnet docker compose up
NETWORK=mainnet

# Agent listings are fetched live from 8004scan (no DB sync)
ERC8004_AUTO_SYNC=false
AGENT_REGISTRY_MODE=erc8004
# Get your key at https://8004scan.io/developers
8004SCAN_API_KEY="your-8004scan-api-key"
8004SCAN_MIN_INTERVAL_MS=2100

# A2A health probe only on GET /agents/:id/a2a-health (not on list/sync)
A2A_HEALTH_ON_SYNC=false
A2A_HEALTH_TIMEOUT_MS=4000

# Verification pipeline: registered (8004scan + BNB Agent SDK) → schema-valid Agent Card → live cron
VERIFY_LIVE_CRON=true
VERIFY_LIVE_INTERVAL_MS=600000
VERIFY_LIVE_START_DELAY_MS=15000
VERIFY_CATALOG_TTL_MS=300000
AGENT_STUDIO_BUILT_WITH_FILTER=bnb-chain/bnbagent-sdk
# THIRDWEB_CLIENT_ID="11e5731a3b0b7e62759919c8cdce1515"
