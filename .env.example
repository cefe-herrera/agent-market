DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/bnb_agent_marketplace?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:4200"

# Agent listings are fetched live from 8004scan (no DB sync)
ERC8004_AUTO_SYNC=false
AGENT_REGISTRY_MODE=erc8004
# Get your key at https://8004scan.io/developers
8004SCAN_API_KEY="your-8004scan-api-key"
8004SCAN_MIN_INTERVAL_MS=2100

# A2A health probe (indexer + GET /agents/:id/a2a-health)
A2A_HEALTH_ON_SYNC=true
A2A_HEALTH_TIMEOUT_MS=4000
# THIRDWEB_CLIENT_ID="11e5731a3b0b7e62759919c8cdce1515"
