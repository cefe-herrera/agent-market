# Template for local.properties. Copy it, fill in real values, and never commit the copy.
#   cp local.properties.example local.properties

# --- Neon PostgreSQL ---
DB_URL=jdbc:postgresql://<host>/neondb?sslmode=require&channel_binding=require
DB_USERNAME=<user>
DB_PASSWORD=<password>

# --- JSON-RPC endpoint, including the API key ---
