DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/bnb_agent_marketplace?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:3001,http://localhost:4200"

DEMO_USER_WALLET="0xDemoUser1234567890123456789012345678901234"
AGENT_REGISTRY_MODE=erc8004
ERC8004_AUTO_SYNC=false
AGENT_STUDIO_PURGE_SEED=true
AGENT_STUDIO_ONLY=false
ERC8004_SYNC_PAGE_SIZE=50
ERC8004_SYNC_MAX_PAGES=10
ERC8004_SYNC_MAX_AGENTS=500
ERC8004_SYNC_CHAINS=

# Get your key at https://8004scan.io/developers
LATEST_8004SCAN_API_KEY="your-8004scan-api-key"
LATEST_8004SCAN_MIN_INTERVAL_MS=2100

# BSC network for indexer + x402 (mainnet | testnet)
NETWORK=mainnet

# Java indexer — run with: ./mvnw spring-boot:run -Dspring-boot.run.arguments=--server.port=8085
INDEXER_BNB_URL=http://127.0.0.1:8085
INDEXER_BNB_TIMEOUT_MS=30000
INDEXER_USABLE_TTL_MS=120000

# x402-rs facilitator — run with: cd x402-rs && NETWORK=mainnet docker compose up
FACILITATOR_URL=http://127.0.0.1:8080
FACILITATOR_TIMEOUT_MS=15000

# x402 $U (keep in sync with agent-market-frontend NEXT_PUBLIC_U_TOKEN_* / NEXT_PUBLIC_X402_PAY_TO)
U_TOKEN_MAINNET=0xcE24439F2D9C6a2289F741120FE202248B666666
U_TOKEN_TESTNET=0xc70B8741B8B07A6d61E54fd4B20f22Fa648E5565
X402_PAY_TO=0xA457Dd1a8D9E243f229EB919d7a08b43802aeD8b
